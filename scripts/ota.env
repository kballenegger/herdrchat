# Kenneth's fork: source this before any build or update command.
#   . scripts/ota.env
# Not secrets: a bundle id, a team id and an EAS project id. The Expo login that
# `eas update` needs lives in ~/.expo (npx eas-cli login), never here.
export HERDRCHAT_BUNDLE_ID=com.kballenegger.herdrchat
export APPLE_TEAM_ID=2TK86C98Z5
export EAS_PROJECT_ID=${EAS_PROJECT_ID:-}
